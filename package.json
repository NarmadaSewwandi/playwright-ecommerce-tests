{
  "name": "playwright-ecommerce-tests",
  "version": "1.0.0",
  "description": "End-to-end test automation for an e-commerce web app using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "test-automation", "e2e", "qa", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
